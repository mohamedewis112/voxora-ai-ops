# ==============================================================================
# Voxora AI (voxora-ai-ops) — environment template
# Copy to .env and fill values. NEVER commit real secrets.
# ==============================================================================

# ---- Local dev database (SQLite via Prisma — the working mirror) ----
DATABASE_URL="file:./db/custom.db"

# ---- Tenant: Daleely (FIRST tenant, adapter: src/integrations/daleely/) ----
# Production: server-side ONLY service-role key. Never expose to the browser.
# DALEELY_SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SECRET_KEY=""                # modern sb_secret_* key, server-only; NEVER NEXT_PUBLIC
# SUPABASE_SERVICE_ROLE_KEY=""           # legacy fallback only
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# DALEELY_LISTINGS_TABLE="listings"
# NEXT_PUBLIC_DALEELY_ADAPTER="supabase" # supabase | local-mirror
# DALEELY_USERS_TABLE="user_profiles"

# ---- Telephony (future self-hosted Asterisk — no paid vendors) ----
# Generic endpoints also configurable at runtime in Settings → Telephony.
# NEXT_PUBLIC_OPS_API_BASE_URL="/api/ops"
# TELEPHONY_BACKEND_URL="http://127.0.0.1:8099"
# TELEPHONY_WS_URL="ws://localhost:8080/media"
# TELEPHONY_API_URL="http://asterisk.local:8088/ari"
# TELEPHONY_API_SECRET=""

# ---- Local AI engine (Whisper.cpp / Ollama / Arabic TTS) ----
# ASR_URL="http://localhost:9000"
# LLM_URL="http://127.0.0.1:11434"
# LLM_MODEL="qwen3:4b"
# TTS_URL="http://127.0.0.1:8091"
# TTS_VOICE="ar_JO-kareem-medium"

# ---- WhatsApp adapter (mock by default — Cloud API later, adapter-based) ----
# WHATSAPP_PROVIDER="mock"           # mock | cloud_api
# WHATSAPP_CLOUD_PHONE_ID=""
# WHATSAPP_CLOUD_TOKEN=""

# ---- Misc ----
# NEXT_TELEMETRY_DISABLED=1
